ENVIRONMENT=development

# LLM Configuration
# By default, we use Groq which is compatible with OpenAI library and offers a generous free tier.
LLM_PROVIDER=groq
# Get a free API key at https://console.groq.com/keys
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-70b-8192

# Backend Integrations
BACKEND_API_URL=http://localhost:3001
ODOO_URL=http://10.0.0.10:8069

# Shared secret for gateway <-> AI engine admin calls
INTERNAL_API_TOKEN=replace-with-random-token
