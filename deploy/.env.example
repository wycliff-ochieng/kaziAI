# Copy to deploy/.env (or the project root .env) on the server and fill in.
# Never commit the real file.

# Public hostname Caddy should obtain a certificate for.
DOMAIN=app.example.com

# Account allowed to change deployment-wide AI model settings.
ADMIN_EMAIL=you@example.com

# Application Postgres. Use the compose service name for the bundled database,
# or an external host/IP for managed Postgres:
# DATABASE_URL=postgres://erpagent:change-me@10.0.0.25:5432/erpagent?sslmode=require
DATABASE_URL=postgres://postgres:change-me@postgres:5432/erpagent?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erpagent
REDIS_URL=redis:6379

# ERP connection. Use an IP/hostname reachable from the Docker network.
# Do NOT use host.docker.internal in production.
# Example: ODOO_URL=http://10.0.0.10:8069
ODOO_URL=http://10.0.0.10:8069
ODOO_DB=your-odoo-db
ODOO_USER=management@example.com
ODOO_PASSWORD=change-me
DEFAULT_ERP_TYPE=ODOO

# Optional fallback LLM settings. The UI-managed values in Postgres override
# these after the first save.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-70b-8192
LLM_API_KEY=
LLM_MAX_TOKENS=400

# Shared secret between the Go gateway and the AI engine. Generate with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-internal-token

# Encrypts LLM API keys stored in Postgres. Generate with:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=change-me-32-byte-secret
